{"name":"jira_remove_watcher","description":"Remove a user from watching a Jira issue.","parameters":{"additionalProperties":false,"properties":{"account_id":{"default":null,"description":"Account ID to remove (for Jira Cloud).","type":"string"},"issue_key":{"description":"Jira issue key (e.g., 'PROJ-123')","pattern":"^[A-Z][A-Z0-9_]+-\\d+(?:-\\d+)*$","type":"string"},"username":{"default":null,"description":"Username to remove (for Jira Server/DC).","type":"string"}},"required":["issue_key"],"type":"object"}}