{"name":"jira_get_agile_boards","description":"Get jira agile boards by name, project key, or type.","parameters":{"additionalProperties":false,"properties":{"board_name":{"default":null,"description":"(Optional) The name of board, support fuzzy search","type":"string"},"board_type":{"default":null,"description":"(Optional) The type of jira board (e.g., 'scrum', 'kanban')","type":"string"},"limit":{"default":10,"description":"Maximum number of results (1-50)","maximum":50,"minimum":1,"type":"integer"},"project_key":{"default":null,"description":"(Optional) Jira project key (e.g., 'PROJ', 'ACV2')","pattern":"^[A-Z][A-Z0-9_]+$","type":"string"},"start_at":{"default":0,"description":"Starting index for pagination (0-based)","minimum":0,"type":"integer"}},"type":"object"}}