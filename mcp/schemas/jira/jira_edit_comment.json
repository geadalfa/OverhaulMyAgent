{"name":"jira_edit_comment","description":"Edit an existing comment on a Jira issue.","parameters":{"additionalProperties":false,"properties":{"body":{"description":"Updated comment text in Markdown format","type":"string"},"comment_id":{"description":"The ID of the comment to edit","type":"string"},"issue_key":{"description":"Jira issue key (e.g., 'PROJ-123', 'ACV2-642')","pattern":"^[A-Z][A-Z0-9_]+-\\d+(?:-\\d+)*$","type":"string"},"visibility":{"default":null,"description":"(Optional) Comment visibility as JSON string (e.g. '{\"type\":\"group\",\"value\":\"jira-users\"}')","type":"string"}},"required":["issue_key","comment_id","body"],"type":"object"}}