{"name":"nexus_update_tag","description":"Update an existing tag (moderator permissions may be required) via v2 GraphQL.\n\nOnly the provided fields are changed; omitted fields stay as-is.\n\nReturns:\n    JSON {success, tag: {id, name}} or an error string.\n","parameters":{"properties":{"adult":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"description":"Adult content tag.","title":"Adult"},"category_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"description":"New tag category ID.","title":"Category Id"},"game_ids":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Comma-separated game IDs to attach.","title":"Game Ids"},"global_tag":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"description":"Mark as global tag.","title":"Global Tag"},"name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"New tag name.","title":"Name"},"tag_id":{"description":"Tag ID.","minimum":1,"title":"Tag Id","type":"integer"}},"required":["tag_id"],"title":"nexus_update_tagArguments","type":"object"}}