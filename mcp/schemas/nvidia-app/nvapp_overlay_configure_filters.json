{
  "name": "nvapp_overlay_configure_filters",
  "description": "Enable or disable the RTX Dynamic Vibrance (DVC) filter.",
  "parameters": {
    "type": "object",
    "properties": {
      "filter": {
        "type": "string",
        "enum": [
          "rtx_dvc"
        ],
        "description": "The game filter to configure"
      },
      "enable": {
        "type": "boolean",
        "description": "true to enable, false to disable"
      }
    },
    "required": [
      "filter",
      "enable"
    ],
    "additionalProperties": false
  }
}