{"name":"start_adb_activity","description":"Start an intent with `am start`: one action, optional data URI, optional explicit component, and up to 16 typed extras (string, boolean, int, long, float). A device-mutating tool; the activity manager's Starting/Error verdict is preserved verbatim.","parameters":{"$defs":{"__schema0":{"description":"Device serial exactly as `adb devices` reports it","maxLength":256,"minLength":1,"pattern":"^[^\\x00\\s\"']+$","type":"string"},"__schema1":{"description":"Intent action to start","maxLength":256,"minLength":1,"pattern":"^[A-Za-z][A-Za-z0-9._\\x2d]*$","type":"string"},"__schema2":{"$ref":"#/$defs/__schema3","description":"Intent data URI (-d)"},"__schema3":{"maxLength":2048,"minLength":1,"pattern":"^[^\\x00\\s]+$","type":"string"},"__schema4":{"$ref":"#/$defs/__schema5","description":"Explicit component to start (-n)"},"__schema5":{"maxLength":512,"minLength":1,"pattern":"^[A-Za-z0-9._\\x2d]+(\\/[A-Za-z0-9._\\x2d]*)?$","type":"string"},"__schema6":{"$ref":"#/$defs/__schema7","default":[],"description":"Typed intent extras (--es/--ez/--ei/--el/--ef)"},"__schema7":{"items":{"$ref":"#/$defs/__schema8"},"maxItems":16,"type":"array"},"__schema8":{"additionalProperties":false,"properties":{"key":{"description":"Extra key","maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9._\\x2d]+$","type":"string"},"type":{"description":"Extra value type","enum":["string","boolean","int","long","float"],"type":"string"},"value":{"description":"Extra value as text, parsed per type","maxLength":2048,"minLength":1,"pattern":"^[^\\x00]*$","type":"string"}},"required":["key","type","value"],"type":"object"}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"examples":[{"action":"android.intent.action.VIEW","data_uri":"https://example.com/path","serial":"emulator-5554"},{"action":"com.example.APP_ACTION","extras":[{"key":"level","type":"int","value":"3"}],"serial":"emulator-5554"}],"properties":{"action":{"$ref":"#/$defs/__schema1","description":"Intent action to start"},"component":{"$ref":"#/$defs/__schema4","description":"Explicit component to start (-n)"},"data_uri":{"$ref":"#/$defs/__schema2","description":"Intent data URI (-d)"},"extras":{"$ref":"#/$defs/__schema6","description":"Typed intent extras (--es/--ez/--ei/--el/--ef)"},"serial":{"$ref":"#/$defs/__schema0","description":"Device serial exactly as `adb devices` reports it"}},"required":["serial","action"],"type":"object"}}